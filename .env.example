# ── Hasura ────────────────────────────────────────────────────────────────────
HASURA_GRAPHQL_ENDPOINT=https://YOUR-PROJECT.hasura.app/v1/graphql
HASURA_GRAPHQL_ADMIN_SECRET=replace-me-from-hasura-console
HASURA_DATA_SOURCE=default

# ── next-auth + Hasura JWT (generate via `npm run keys:generate`) ─────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=base64url-32-bytes
HASURA_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
HASURA_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# ── Google OAuth — https://console.cloud.google.com/apis/credentials ──────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
