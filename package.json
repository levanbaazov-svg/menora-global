{
  "name": "menora-global",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "migrate": "migrate --migrations-dir=migrations --store=./scripts/migrate-store.js",
    "migrate:up": "migrate up --migrations-dir=migrations --store=./scripts/migrate-store.js",
    "migrate:down": "migrate down --migrations-dir=migrations --store=./scripts/migrate-store.js",
    "migrate:list": "migrate list --migrations-dir=migrations --store=./scripts/migrate-store.js",
    "migrate:create": "migrate create --migrations-dir=migrations",
    "metadata:apply": "node scripts/apply-metadata.js",
    "keys:generate": "node scripts/gen-jwt-keys.js",
    "seed": "node scripts/seed.js",
    "invite": "node scripts/invite.js"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^16.4.7",
    "migrate": "^2.1.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@hebcal/core": "^6.5.2",
    "graphql": "^16.14.0",
    "graphql-request": "^7.4.0",
    "jose": "^6.2.3",
    "next": "^16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  }
}
